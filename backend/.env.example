# Copia este archivo como ".env" y llena los valores reales. NUNCA subas el .env real a GitHub.

# Puerto del servidor
PORT=4000

# --- Base de datos (MongoDB Atlas, gratis) ---
# Créala en https://www.mongodb.com/cloud/atlas/register (plan gratuito M0).
# En Atlas: Database > Connect > Drivers, copia el string y reemplaza <password>
# por la contraseña real del usuario que crees.
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/animemos-metro

# Clave para firmar los tokens de sesion (invéntate una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# --- Correo (para que los reportes de trabajadores lleguen de verdad) ---
# Cuenta de Gmail que ENVIA el correo. Puede ser la misma AyudaMetroMedellin@gmail.com
# u otra cuenta distinta. Debes crear una "Contraseña de aplicacion" en Gmail
# (Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contraseñas de aplicaciones).
# NO uses tu contraseña normal de Gmail aqui.
EMAIL_USER=tu_cuenta_de_envio@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion_de_16_caracteres

# Correo que RECIBE los reportes
EMAIL_TO=AyudaMetroMedellin@gmail.com

# --- Asistente de IA (opcional, pero si quieres que responda de verdad, es obligatorio) ---
# Consigue tu API key en https://console.anthropic.com/
ANTHROPIC_API_KEY=tu_api_key_de_anthropic
